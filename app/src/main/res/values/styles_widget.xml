<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Widget.Fff3.Chip" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@drawable/widget_chip</item>
        <item name="android:gravity">center</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingHorizontal">8dp</item>
    </style>

    <style name="Widget.Fff3.ChipDot" parent="">
        <item name="android:layout_width">12dp</item>
        <item name="android:layout_height">12dp</item>
        <item name="android:layout_marginEnd">6dp</item>
        <item name="android:importantForAccessibility">no</item>
        <item name="android:src">@drawable/widget_circle</item>
    </style>

    <style name="Widget.Fff3.ChipText" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:ellipsize">end</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">@color/widget_on_chip</item>
        <item name="android:textSize">13sp</item>
    </style>
</resources>
